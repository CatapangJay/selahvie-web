# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser;
# row-level security (db/migrations/0007) is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Photo uploads. Defaults shown; only set these to change them.
# STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_BUCKET=wedding-photos
