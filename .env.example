# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser;
# row-level security (db/migrations/0007) is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or the legacy service_role key. Server-only: used by
# checkout, demo seeding and public site lookups. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: Postgres connection string (Project Settings → Database) for running
# db/migrations and db/adapters/supabase by hand. The app itself doesn't use it.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Photo uploads. Defaults shown; only set these to change them.
# STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_BUCKET=wedding-photos
